{
  "name": "spechub-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx --env-file=.env --watch src/start.ts",
    "start": "tsx --env-file=.env src/start.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:eslint": "eslint src/",
    "check:circular": "madge --circular --extensions ts --ts-config tsconfig.json src/",
    "lint": "npm run typecheck && npm run check:circular && npm run lint:eslint && npm run test"
  },
  "dependencies": {
    "@mastra/core": "1.51.0",
    "@mastra/mcp": "1.14.0",
    "@xenova/transformers": "^2.17.2",
    "awilix": "^13.0.5",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "pg": "^8.13.0",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3",
    "zod": "^3.24.0",
    "turndown": "^7.2.0",
    "sanitize-html": "^2.13.0",
    "adf-to-md": "^1.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/sequelize": "^4.28.20",
    "eslint": "^9.39.5",
    "madge": "^8.0.0",
    "mastra": "^1.19.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "@types/turndown": "^5.0.5",
    "@types/sanitize-html": "^2.13.0"
  }
}
