# Database connection (individual vars take priority over DATABASE_URL)
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_USER=spechub
DATABASE_PASSWORD=spechub
DATABASE_NAME=spechub

# Fallback connection string (used if individual vars not set)
DATABASE_URL=postgresql://spechub:spechub@localhost:5434/spechub
PORT=3456

# Public URL of the server (must be the externally reachable URL in production)
PUBLIC_URL=http://localhost:3456

# Static Access Tokens (for AI agents; no interactive login flow)
# Comma-separated list. Agents pass token via Authorization: Bearer <token>
# SPECHUB_ACCESS_TOKENS=token1,token2

# Google OAuth Authentication
# Set all three to enable full OAuth flow for human users (browser login + callback)
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_ALLOWED_DOMAINS=example.com,corp.example.com
